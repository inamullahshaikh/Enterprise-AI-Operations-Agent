            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Run this last - it revokes the refresh token in the Postman cookie jar, so 'Refresh access token' will 401 afterwards until you register/login again."
          }
