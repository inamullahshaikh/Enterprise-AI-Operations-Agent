    {
      "name": "LLM Gateway (debug)",
      "item": [
        {
          "name": "Gemini ping (structured output -> llm_calls)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has a model and cost', () => {",
                  "    pm.expect(body.model).to.be.a('string');",
                  "    pm.expect(parseFloat(body.cost_usd)).to.be.at.least(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "url": {
