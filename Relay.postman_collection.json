              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Relies on Postman's cookie jar sending the `relay_refresh` httpOnly cookie set at register/login. Rotates the refresh token and mints a new access token (docs/system-design.md section 18.2)."
          }
        },
        {
          "name": "Reuse an already-rotated refresh token (expect 401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The previous 'Refresh' request already rotated the cookie in Postman's",
                  "// jar, so calling refresh twice in a row here reuses a token that's",
                  "// already been rotated away, tripping reuse detection.",
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Run 'Refresh access token' immediately before this request twice in",
                  "// the same run for this to actually be a reuse; on a single run it may",
                  "// still be the first use and return 200, which is also fine.",
                  "pm.test('status is 200 or 401', () => pm.expect([200, 401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "docs/system-design.md section 18.2 reuse detection. To see the 401 for real: run 'Refresh access token' once manually, copy the `relay_refresh` cookie value, run it again (rotating it), then replay the first value with a REST client that lets you set cookies explicitly - Postman's own jar always sends the latest one, so back-to-back runs here mostly demonstrate normal rotation (200), not reuse. tests/integration/test_auth_flow.py exercises the true reuse case directly."
          }
        },
        {
          "name": "Google Sign-In start (reference only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google", "start"]
            },
            "description": "docs/adr/0007-google-sign-in.md. This is a browser redirect flow, not really a Postman-testable JSON call. Without GOOGLE_OAUTH_CLIENT_ID/SECRET configured it returns 503; with them configured it 302s to Google's consent screen (Postman will show the redirect response rather than following it into a browser)."
          }
        },
