    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (primary user)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('primaryEmail')) {",
                  "    pm.collectionVariables.set('primaryEmail', `relay.owner.${Date.now()}@example.com`);",
                  "    pm.collectionVariables.set('primaryPassword', 'correct horse battery staple');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has access_token', () => pm.expect(body.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('accessToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{primaryEmail}}\",\n  \"password\": \"{{primaryPassword}}\",\n  \"full_name\": \"Relay Owner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Creates a user and immediately logs them in (also sets the `relay_refresh` httpOnly cookie in Postman's cookie jar for this domain)."
          }
        },
        {
          "name": "Register with same email again (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('problem-details shape', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('title');",
                  "    pm.expect(body.status).to.eql(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{primaryEmail}}\",\n  \"password\": \"a different password\",\n  \"full_name\": \"Duplicate\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "docs/system-design.md section 15.1 - duplicate email is a 409, RFC 9457 problem+json body."
          }
        },
