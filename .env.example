ENV=dev
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://relay:relay@postgres:5432/relay
LANGGRAPH_DB_URL=postgresql://relay:relay@postgres:5432/relay
REDIS_URL=redis://redis:6379/0

# Object storage — Cloudflare R2 (S3-compatible API), used in every environment
# including local dev. Create an R2 bucket + API token in the Cloudflare dashboard.
# R2_ENDPOINT_URL is https://<account_id>.r2.cloudflarestorage.com — boto3 clients
# must use region_name="auto" and addressing_style="path" against this endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=relay
R2_ENDPOINT_URL=

# Demo company database (the "customer" the agent queries)
DEMO_DB_URL=postgresql+asyncpg://acme:acme@demo-db:5432/acme

# Auth
JWT_PRIVATE_KEY_PATH=/secrets/jwt_ed25519.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt_ed25519.pub
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14

# Google Sign-In (user login, in addition to email/password). Uses the same OAuth
# client as the Gmail/Calendar connector below, requested with minimal identity
# scopes (openid email profile) at login time vs. broader scopes at connector
# install time. See docs/adr/0007-google-sign-in.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encryption
KMS_PROVIDER=local                     # local | aws
LOCAL_MASTER_KEY=base64:CHANGE_ME_DEV_ONLY
AWS_KMS_KEY_ID=

# Gemini
GEMINI_API_KEY=
MODEL_PLANNER=gemini-3.8-flash
MODEL_PLANNER_THINKING=high
MODEL_EXECUTOR=gemini-3.8-flash
MODEL_EXECUTOR_THINKING=low
MODEL_VALIDATOR=gemini-3.8-flash
MODEL_VALIDATOR_THINKING=medium
MODEL_LIGHT=gemini-3.5-flash-lite
MODEL_LIGHT_THINKING=minimal
MODEL_FALLBACK_EXECUTOR=gemini-3.7-flash
MODEL_ESCALATION=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GEMINI_RPM_LIMIT=60

# Connectors
SANDBOX_URL=http://sandbox:8080
SANDBOX_TIMEOUT_S=30
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
# Gmail / Calendar connector installs reuse GOOGLE_OAUTH_CLIENT_ID/SECRET from the
# Auth section above, requesting Gmail/Calendar scopes at install time instead of
# the minimal login scopes used for Sign in with Google.
USE_MOCK_CONNECTORS=true
