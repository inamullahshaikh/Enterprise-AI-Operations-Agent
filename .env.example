ENV=dev
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://relay:relay@postgres:5432/relay
LANGGRAPH_DB_URL=postgresql://relay:relay@postgres:5432/relay
REDIS_URL=redis://redis:6379/0

# Object storage — Cloudflare R2 (S3-compatible API), used in every environment
# including local dev. Create an R2 bucket + API token in the Cloudflare dashboard.
# R2_ENDPOINT_URL is https://<account_id>.r2.cloudflarestorage.com — boto3 clients
# must use region_name="auto" and addressing_style="path" against this endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=relay
R2_ENDPOINT_URL=

# Demo company database (the "customer" the agent queries)
DEMO_DB_URL=postgresql+asyncpg://acme:acme@demo-db:5432/acme

# Auth
JWT_PRIVATE_KEY_PATH=/secrets/jwt_ed25519.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt_ed25519.pub
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14

# Google Sign-In (user login, in addition to email/password). Uses the same OAuth
# client as the Gmail/Calendar connector below, requested with minimal identity
# scopes (openid email profile) at login time vs. broader scopes at connector
# install time. See docs/adr/0007-google-sign-in.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encryption
KMS_PROVIDER=local                     # local | aws
LOCAL_MASTER_KEY=base64:CHANGE_ME_DEV_ONLY
AWS_KMS_KEY_ID=

# Gemini
GEMINI_API_KEY=
MODEL_PLANNER=gemini-3.8-flash
MODEL_PLANNER_THINKING=high
MODEL_EXECUTOR=gemini-3.8-flash
MODEL_EXECUTOR_THINKING=low
MODEL_VALIDATOR=gemini-3.8-flash
MODEL_VALIDATOR_THINKING=medium
MODEL_LIGHT=gemini-3.5-flash-lite
MODEL_LIGHT_THINKING=minimal
MODEL_FALLBACK_EXECUTOR=gemini-3.7-flash
MODEL_ESCALATION=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GEMINI_RPM_LIMIT=60

# Connectors
SANDBOX_URL=http://sandbox:8080
SANDBOX_TIMEOUT_S=30
# Gmail / Calendar connector installs reuse GOOGLE_OAUTH_CLIENT_ID/SECRET from the
# Auth section above, requesting Gmail/Calendar scopes at install time instead of
# the minimal login scopes used for Sign in with Google. Register
# {API_BASE_URL}/api/v1/oauth/callback as an authorized redirect URI on that client:
# it is the only one Relay uses, for every workspace and connector.
# Where tokens are exchanged and refreshed. Point it at the mock service
# (http://mock-services:8100/oauth/token) to exercise the flow without Google.
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
USE_MOCK_CONNECTORS=true
# Mock Gmail/Calendar/web search service (mocks/). seed_demo and relay-eval point installs here.
MOCK_SERVICES_URL=http://mock-services:8100
# Sample MCP ticketing server (mcp_examples/ticketing). Only relay-eval installs it automatically.
MCP_TICKETING_URL=http://mcp-ticketing:8200/mcp
# Hostnames the SSRF guard lets reach private addresses (JSON list). Dev stack services only.
SSRF_ALLOWED_HOSTS=["mock-services","mcp-ticketing"]

# Rate limits, per minute (section 15.6). Fixed windows in Redis; a Redis outage lets traffic through.
RATE_LIMIT_MESSAGES_PER_USER_MIN=60
RATE_LIMIT_MESSAGES_PER_WORKSPACE_MIN=600
RATE_LIMIT_CONNECTOR_TESTS_MIN=10
# Concurrent runs per workspace (section 19.3). Extra runs stay queued and retry with backoff.
MAX_CONCURRENT_RUNS_PER_WORKSPACE=3
# Retention: the worker's nightly apply_retention job deletes tool outputs, attachments and agent
# checkpoints older than each workspace's workspace_policies.data_retention_days (0 = never).

# Eval harness: the fabrication judge's model, pinned apart from MODEL_VALIDATOR.
MODEL_EVAL_JUDGE=gemini-3.8-flash
# Section 21.6 experiment toggles (evals/EXPERIMENTS.md). Defaults are production behaviour.
EXPERIMENT_SINGLE_REACT=false
TOOL_RETRIEVAL_ENABLED=true
RAG_HYBRID=true
RAG_RERANK=true
RAG_EMBED_CONTEXT_HEADERS=false
WRAP_UNTRUSTED_OUTPUT=true
